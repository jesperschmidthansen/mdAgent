#include <octave/oct.h>
#include <stdlib.h>


#define HELP ("Usage:  \n")

DEFUN_DLD(pair_force, args, ,HELP){
	octave_value_list retval;

	ColumnVector pidx(args(0).vector_value());
	ColumnVector random_numbers(args(1).vector_value());
	RowVector crit_prob(args(2).vector_value());
	Matrix r(args(3).matrix_value());
	Matrix vi(args(4).matrix_value());
	types 
	const unsigned nagents = (unsigned)args(5).scalar_value(); 
	const unsigned max_nagents = (unsigned)args(6).scalar_value(); 
	
	
	unsigned npart = pidx.length();

	unsigned new_part = nagents; 
	for ( unsigned n=0; n<npart; n++ ){
		unsigned i = pidx(n);
		if ( random_numbers(n) < crit_prob(i) )
			pidx(n) = 1;
		else 

			new_part ++;
			if ( new_part > max_nagents ){
				octave_stdout << "Agent limit exceeded \n";
		  		break;	
			}

			for ( int k=0; k<3; k++ ){ 
				r(new_part, k) = r(i, k);
				v(new_part, k) = rand()/(RAND_MAX+1.0) - 0.5;
			}


					this.types(na) = type;
					this.nagents = na;
				end
			end


